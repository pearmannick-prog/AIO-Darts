# Generated by the Android build - regenerated on every run, never committed
node_modules/
www/
android/

# Portable Node downloaded by the local Windows launcher
node/

# The packaged Windows build. electron-builder output, plus the Electron binary
# it unpacks - hundreds of megabytes, all of it reproducible from desktop/
# with `npm install && npm run dist`.
desktop/dist/

# Generated by desktop/stamp.js at package time - the commit a build came from.
# Never committed: it describes one build on one machine, and a checked-in copy
# would claim a SHA that has nothing to do with the tree you are looking at.
desktop/version.json

# The accounts/statistics SQLite database, and any scratch copy of it. Local
# data, never committed - along with the -wal/-shm files WAL mode writes beside
# it.
#
# The patterns are deliberately wider than "data/". A one-off test run with
# DATA_DIR pointed somewhere else got its database committed, because the
# ignore rule named one exact directory and `git add -A` swept up the rest.
data/
data-*/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
